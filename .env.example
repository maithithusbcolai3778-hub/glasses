# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# DashScope API key for Qwen-VL cloud calls (used by qwen_agent.py)
DASHSCOPE_API_KEY=sk-your-key-here

# Wi-Fi credentials (used if you run agent scripts that need them)
WIFI_SSID=your-ssid
WIFI_PASSWORD=your-password

# Optional: HTTP proxy for edge-tts / cloud services
# EDGE_TTS_PROXY=http://127.0.0.1:7892

# Optional: default ESP32 host/IP
# ESP32_HOST=192.168.1.100
